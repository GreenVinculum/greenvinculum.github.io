---
import { Image } from "astro:assets";
import sidebarProfile from "../../assets/images/sidebar-profile.jpg";
---

<div class="site-logo-stack">
  <a href="/" class="site-logo-link block transition ease-in-out hover:scale-[102%]">
    <div class="site-logo-figure">
      <Image
        class="site-logo site-logo--photo"
        src={sidebarProfile}
        alt="Charles Ahn"
        width={340}
        height={340}
      />
    </div>
  </a>
</div>
