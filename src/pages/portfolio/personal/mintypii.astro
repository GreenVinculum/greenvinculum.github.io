---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "MintyPii";
const description =
  "MintyPii is a pocket-sized, iPod-inspired music player built around a Raspberry Pi Zero 2 W, Pimoroni Pirate Audio HAT, and rotary dial — all packed into an Altoids mint tin.";
const heroImage = "/portfolio/personal-projects/mintypii/hero.jpg";
const wiringImage = "/portfolio/personal-projects/mintypii/wiring.jpg";
const tags = ["Raspberry Pi", "Hardware", "Embedded", "Audio"];

const parts = [
  { item: "Raspberry Pi Zero 2 W", note: "Main compute — Wi-Fi for syncing, enough headroom for decoding and UI" },
  { item: "Pimoroni Pirate Audio", note: "DAC, headphone amp, and mini LCD with A/B/X/Y buttons" },
  { item: "Inland rotary encoder", note: "Scroll through tracks and menus; press to confirm" },
  { item: "Altoids mint tin", note: "Metal enclosure — tight, but that is part of the charm" },
  { item: "MicroSD card", note: "OS, player software, and music library" },
  { item: "Toggle switch", note: "Power cut-off mounted through the tin wall" },
  { item: "Wiring + 3D-printed insert", note: "Yellow tray holds the stack; short jumpers keep the layout tidy" },
];

const buildSteps = [
  {
    title: "Define the interaction model",
    body: "The goal for MintyPii was an iPod-like pocket player: a rotary dial for browsing, Pirate Audio buttons for confirm and back, and a tiny LCD for now-playing feedback. Menus stay shallow — library, playlists, now playing, settings — so everything is quick to reach with one hand.",
  },
  {
    title: "Stack the electronics",
    body: "The Pi Zero 2 W sits under the Pirate Audio HAT, which brings DAC, headphone amp, LCD, and four face buttons into one Zero-sized board. GPIO lines run to the Inland rotary encoder for quadrature scroll and switch input, with a toggle switch on the tin for hard power.",
  },
  {
    title: "Lay out the tin",
    body: "An Altoids tin is smaller than it looks on paper. A yellow 3D-printed insert seats the boards; holes were cut for the headphone jack, encoder shaft, screen window in the lid, and power switch. The metal case stays lined so nothing shorts against the walls.",
  },
  {
    title: "Software and library sync",
    body: "MintyPii indexes local files on the SD card. Tracks can be copied over USB or synced over Wi-Fi when the tin is on the bench. Encoder events map to menu navigation and volume — rotate to move, click to enter — while the Pirate Audio buttons cover select, back, and transport.",
  },
  {
    title: "Tune and test",
    body: "With everything closed up, the hard parts are mechanical: encoder feel, jack strain relief, lid clearance for the LCD window, and heat. The build was tested for headphone output level, menu responsiveness, and whether the lid still closes without pressing on the HAT.",
  },
];
---

<BaseLayout title={title} description={description} sideBarActiveItemID="portfolioPersonal">
  <article class="project-page max-w-[750px]">
    <a href="/portfolio/personal" class="text-sm text-base-content/60 hover:text-secondary no-underline">
      ← Personal projects
    </a>

    <header class="mt-4 mb-8">
      <img
        src={heroImage}
        alt="Open MintyPii Altoids tin with Pirate Audio HAT, rotary encoder, and headphone jack"
        width="1024"
        height="768"
        class="w-full rounded-lg border border-base-300 shadow-lg mb-6 object-cover"
      />
      <h1 class="text-4xl font-bold leading-tight mb-3">{title}</h1>
      <p class="text-lg text-base-content/80 leading-relaxed">{description}</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag) => (
          <span class="badge badge-outline">{tag}</span>
        ))}
      </div>
    </header>

    <div class="divider"></div>

    <section class="prose prose-lg max-w-none mb-10">
      <h2>Overview</h2>
      <p>
        <strong>MintyPii</strong> is a deliberately impractical, very satisfying build: a music player that fits in an Altoids tin and behaves a bit like a classic iPod. A rotary dial, Pirate Audio’s mini LCD and buttons, headphones, and a library of tracks on the Pi do the rest.
      </p>
      <p>
        The project started as a weekend hardware exercise: could a Zero 2 W, a proper headphone amp, and one good encoder feel good in the hand? The answer is yes, as long as you respect how little room a mint tin actually has.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">Build photos</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <figure class="m-0">
          <img
            src={heroImage}
            alt="MintyPii internals in the mint tin with Pirate Audio and rotary dial"
            width="1024"
            height="768"
            class="w-full rounded-lg border border-base-300 object-cover"
            loading="lazy"
          />
          <figcaption class="mt-2 text-sm text-base-content/70">
            Open tin: Pirate Audio LCD/DAC stack, Inland encoder, and power switch.
          </figcaption>
        </figure>
        <figure class="m-0">
          <img
            src={wiringImage}
            alt="Raspberry Pi Zero 2 underside with soldered wiring for MintyPii"
            width="768"
            height="1024"
            class="w-full rounded-lg border border-base-300 object-cover"
            loading="lazy"
          />
          <figcaption class="mt-2 text-sm text-base-content/70">
            Pi Zero 2 wiring before the stack goes into the yellow insert.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">Hardware</h2>
      <div class="overflow-x-auto rounded-lg border border-base-300">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>Part</th>
              <th>Role</th>
            </tr>
          </thead>
          <tbody>
            {parts.map(({ item, note }) => (
              <tr>
                <td class="font-medium whitespace-nowrap">{item}</td>
                <td>{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose prose-lg max-w-none mb-10">
      <h2>Why these parts</h2>
      <ul>
        <li>
          <strong>Raspberry Pi Zero 2 W</strong> — quad-core SoC in a board the size of a stick of gum. Enough for local playback and a lightweight UI loop without needing a display.
        </li>
        <li>
          <strong>Pimoroni Pirate Audio</strong> — DAC, headphone amp, mini LCD, and four buttons on one Zero-sized board, so the tin gets a screen without a second module stack.
        </li>
        <li>
          <strong>Inland rotary encoder</strong> — the main input. Detents make scrolling through albums feel tactile, similar to a click wheel stripped down to one control.
        </li>
        <li>
          <strong>Altoids tin</strong> — iconic enclosure, metal shielding, and a built-in flex when you close the lid. It forces discipline on board height and connector placement.
        </li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">Build process</h2>
      <ol class="space-y-6">
        {buildSteps.map(({ title: stepTitle, body }, index) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary text-secondary-content text-sm font-bold">
              {index + 1}
            </span>
            <div>
              <h3 class="text-lg font-semibold mb-1">{stepTitle}</h3>
              <p class="text-base-content/80 leading-relaxed">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="prose prose-lg max-w-none mb-10">
      <h2>Enclosure notes</h2>
      <p>
        The tin is the product. Every millimeter matters: Pirate Audio’s jack and LCD placement drive where the Pi sits, the lid needs a window for the screen, and the encoder knob has to clear the closed case. Kapton or tape on the inside walls keeps the metal from shorting pins.
      </p>
      <p>
        A toggle switch cuts power through the side wall. When closed, MintyPii reads as a pocket gadget — open it and the yellow insert plus green boards are the reveal.
      </p>
    </section>

    <section class="prose prose-lg max-w-none mb-10">
      <h2>Challenges</h2>
      <ul>
        <li><strong>Height budget</strong> — HAT + Pi + insert must stay below the lid ridge while leaving room for the LCD window. Shaving a fraction of a millimeter can be the difference between “closes” and “does not.”</li>
        <li><strong>Grounding</strong> — metal tin means thoughtful grounding and isolation so the jack and encoder do not pick up noise.</li>
        <li><strong>Pocket UX</strong> — dial plus four buttons need a shallow menu; the tiny LCD has to stay readable without turning the tin into a phone.</li>
        <li><strong>Thermal &amp; battery</strong> — continuous playback in a closed tin warms up; venting or power budgeting may be needed for long sessions.</li>
      </ul>
    </section>

    <section class="prose prose-lg max-w-none">
      <h2>Status &amp; next steps</h2>
      <p>
        MintyPii is functional: browse a library, pick a track, listen on headphones, all from a mint tin on the desk. Planned improvements include a cleaner cable harness, better strain relief on the headphone jack, and optional Wi-Fi sync for dropping new albums onto the SD card without opening the case.
      </p>
    </section>
  </article>
</BaseLayout>
