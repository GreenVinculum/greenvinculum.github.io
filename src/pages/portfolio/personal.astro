---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
---

<BaseLayout title="Personal Projects" sideBarActiveItemID="portfolioPersonal">
  <div class="space-y-4 mb-5">
    <div class="text-3xl w-full font-bold">Personal Projects</div>
  </div>

  <div class="mt-5">
    <HorizontalCard
      title="Building a Drone"
      img="/portfolio/personal-projects/pixhawk-drone/hero.jpg"
      desc="Ongoing Pixhawk 6C build — flight controller bring-up, power, radios, and first flights still ahead."
      url="/portfolio/personal/pixhawk-drone"
      target="_self"
      badge="Ongoing"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Stellar Slither"
      img="/portfolio/personal-projects/stellar-slither/hero.svg"
      desc="Snake on a Pimoroni Stellar Unicorn LED matrix, played with an Adafruit Qwiic Gamepad."
      url="/portfolio/personal/stellar-slither"
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="MintyPii"
      img="/portfolio/personal-projects/mintypii/hero.jpg"
      desc="iPod-inspired pocket player in an Altoids tin — Raspberry Pi Zero 2 W, Pirate Audio, and an Inland rotary dial."
      url="/portfolio/personal/mintypii"
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Weekend Garden Landscaping"
      img="/portfolio/personal-projects/garden-stone-edge/hero.jpg"
      desc="Cut a clean bed line and dry-stack a stone edge / low retainer for soil, mulch, and plantings."
      url="/portfolio/personal/garden-stone-edge"
      target="_self"
    />
  </div>
</BaseLayout>
